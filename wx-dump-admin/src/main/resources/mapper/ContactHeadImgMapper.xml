<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xcs.wx.mapper.ContactHeadImgMapper">

    <resultMap id="contactHeadImgMap" type="com.xcs.wx.domain.ContactHeadImg">
        <result property="usrName" column="username" />
        <result property="createTime" column="update_time" />
        <result property="smallHeadBuf" column="image_buffer" typeHandler="org.apache.ibatis.type.ByteArrayTypeHandler"/>
        <result property="headImgMd5" column="md5" />
    </resultMap>

    <select id="getContactHeadImg" resultMap="contactHeadImgMap" parameterType="String">
        SELECT username, update_time, image_buffer, md5
        FROM head_image
        WHERE username = #{usrName}
        LIMIT 1
    </select>

</mapper>
